# ==============================================================================
# Fe El-Tareeq (في الطريق) - Frontend Environment Variables Configuration
# ==============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=https://fe-el-tareeq-api-staging.onrender.com

# Real-time WebSocket Server URL (Low-Bandwidth Chat & Live Tracking)
VITE_SOCKET_URL=wss://fe-el-tareeq-api-staging.onrender.com

# App Environment Mode (development | staging | production)
VITE_APP_ENV=development

# WhatsApp Fallback Support Phone (International format without leading +)
VITE_WHATSAPP_SUPPORT_PHONE=970599123456

# Digital Wallets Merchant Integration Keys (Optional - Client side)
VITE_JAWWAL_PAY_MERCHANT_ID=